# Active Broker Selection: alpaca (default) | ibkr | tradier | schwab | paper
BROKER=alpaca

# 1. Alpaca (Paper or Live)
# Get yours at: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=your_alpaca_paper_key_id
ALPACA_API_SECRET_KEY=your_alpaca_paper_secret_key
ALPACA_PAPER=true

# 2. Interactive Brokers (IBKR Client Portal Gateway)
# Set BROKER=ibkr and run the IBKR Client Portal Gateway locally
# IBKR_BASE_URL=https://localhost:5000/v1/api
# IBKR_ACCOUNT_ID=DU1234567

# 3. Tradier (Sandbox or Live)
# Set BROKER=tradier — get sandbox token at https://developer.tradier.com
# TRADIER_ACCESS_TOKEN=your_tradier_token
# TRADIER_ACCOUNT_ID=your_tradier_account_id
# TRADIER_SANDBOX=true

# 4. Charles Schwab (Trader API)
# Set BROKER=schwab — requires OAuth access token & encrypted account hash
# SCHWAB_ACCESS_TOKEN=your_schwab_bearer_token
# SCHWAB_ACCOUNT_HASH=your_schwab_account_hash

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Bot Configuration & Scaled Execution Plan
# 3-Level Entry (40%/40%/20%) | 3-Level TP (40%/40%/20%) | 2-Level SL (50%/50%)
POLL_INTERVAL_SECONDS=120
MAX_TRADE_ALLOCATION_USD=500
MAX_RISK_PER_TRADE_USD=3.5
ENTRY_DIP_2_PCT=0.35
ENTRY_DIP_3_PCT=0.7
STOP_LOSS_1_PCT=0.5
STOP_LOSS_2_PCT=0.9
MIN_REWARD_RISK_RATIO=2.0
TP1_PCT=1.0
TP2_PCT=1.8
TP3_PCT=2.6

# Safer Strategy & Signal Verification Guardrails (A+ setups only, max 10 trades/day)
SAFE_MODE=true
MIN_CONFIDENCE=70
MIN_SAFETY_SCORE=75
MAX_DAILY_VOLATILITY_PCT=10
MAX_OPEN_POSITIONS=3
MAX_DAILY_TRADES=10
MAX_DAILY_LOSS_PCT=1.5

REDDIT_USER_AGENT=macos:degen-sentinel:v1.0.0 (by /u/your_username)
SP500_WATCHLIST=AMZN,MSFT,AAPL,GOOGL,META,NVDA,JPM,V,COST,WMT,LLY,NFLX,AVGO,CRM,XOM

# Optional: Reddit OAuth (recommended if Reddit blocks unauthenticated .json requests)
# Create a "script" app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
